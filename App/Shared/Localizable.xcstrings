      }
    },
    "error.passkey" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Passkey-Anmeldung wurde abgebrochen oder ist fehlgeschlagen. Versuche es noch einmal."
          }
        }
      }
    },
    "error.passkey.cancelled" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Passkey-Anmeldung wurde abgebrochen. Wenn auf diesem Gerät kein Passkey für %@ im iCloud-Schlüsselbund liegt (zum Beispiel weil du das Konto im Browser mit einem anderen Passwortmanager angelegt hast), lege einen neuen per Wiederherstellungscode an."
          }
        }
      }
    },
    "error.passkey.failed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Passkey-Anmeldung ist fehlgeschlagen. Wahrscheinlich liegt auf diesem Gerät kein passender Passkey für %@ im iCloud-Schlüsselbund. Lege einen neuen Passkey per Wiederherstellungscode an und prüfe, dass der iCloud-Schlüsselbund aktiviert ist."
          }
        }
      }
    },
    "error.passkey.invalidResponse" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das System hat eine ungültige Passkey-Antwort geliefert. Versuche es noch einmal; bleibt der Fehler, starte das Gerät neu."
          }
        }
      }
    },
    "error.passkey.notAssociated" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät konnte die Verknüpfung dieser App mit %@ noch nicht bestätigen (Associated Domains). Das ist keine Passkey-Frage. Prüfe, dass das Gerät online ist, warte einige Minuten, starte das Gerät neu bzw. installiere die App neu und versuche es erneut."
          }
        }
      }
    },
    "error.passkey.notConfigured" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät kann kein Passkey angelegt werden. Aktiviere den iCloud-Schlüsselbund und einen Gerätecode in den Einstellungen."
          }
        }
      }
    },
    "error.passkey.notHandled" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das System hat die Passkey-Anfrage nicht verarbeitet. Prüfe, dass der iCloud-Schlüsselbund aktiviert ist, und versuche es noch einmal."
          }
        }
      }
    },
    "error.passkey.notInteractive" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Passkey-Abfrage konnte nicht angezeigt werden. Bring die App in den Vordergrund und versuche es noch einmal."
          }
        }
      }
    },
    "error.passkey.unknown" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Passkey-Anmeldung ist aus unbekanntem Grund fehlgeschlagen. Versuche es noch einmal oder nutze einen Wiederherstellungscode."
          }
        }
      }
    },
    "error.passwordDisabled" : {
      "localizations" : {
        "de" : {
